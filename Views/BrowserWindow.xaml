<Window x:Class="RobloxAccountManager.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Вход в аккаунт Roblox" Height="720" Width="1020"
        WindowStartupLocation="CenterOwner"
        Background="#12131A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#1B1D29" BorderBrush="#2A2D3E" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatusText"
                               Text="Войдите в аккаунт Roblox — программа автоматически сохранит сессию после входа"
                               Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ManualCaptureBtn" Content="Проверить вход сейчас"
                            Click="ManualCaptureBtn_Click"
                            Background="#3B82F6" Foreground="White" BorderThickness="0"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="Закрыть" Click="CloseBtn_Click"
                            Background="#2A2D3E" Foreground="#CBD5E1" BorderThickness="0"
                            Padding="12,6" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#12131A"/>
            <Border x:Name="LoadingOverlay" Background="#12131A">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Загрузка встроенного браузера Roblox..."
                               Foreground="#94A3B8" FontSize="15" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
