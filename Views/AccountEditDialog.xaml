<Window x:Class="RobloxAccountManager.Views.AccountEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аккаунт" Height="350" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#10121C"
        ToolTipService.InitialShowDelay="250">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="DialogTitleText" Text="Аккаунт"
                       Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

            <StackPanel Grid.Row="1">
                <StackPanel x:Name="CookiePanel" Margin="0,0,0,12"
                            ToolTip="Вставьте строку .ROBLOSECURITY из браузера. Токен хранится только на вашем ПК в зашифрованном виде (Windows DPAPI).">
                    <TextBlock Text="Токен .ROBLOSECURITY"
                               Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="CookieTextBox"
                             Background="#181C2B" Foreground="#F1F5F9" BorderBrush="#282E46"
                             Padding="10,7" FontSize="12"/>
                </StackPanel>

                <TextBlock Text="Группа"
                           Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="GroupComboBox" IsEditable="True"
                          Background="#181C2B" Foreground="#1E2030"
                          Padding="8,6" FontSize="13" Margin="0,0,0,12"
                          ToolTip="Выберите группу из списка или введите своё название для удобной фильтрации">
                    <ComboBoxItem Content="Основные"/>
                    <ComboBoxItem Content="Фарм"/>
                    <ComboBoxItem Content="Твинки"/>
                    <ComboBoxItem Content="Трейд"/>
                    <ComboBoxItem Content="Хранилище"/>
                </ComboBox>

                <TextBlock Text="Заметка"
                           Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="NoteTextBox"
                         Background="#181C2B" Foreground="#F1F5F9" BorderBrush="#282E46"
                         Padding="10,7" FontSize="13" AcceptsReturn="False"
                         ToolTip="Любое краткое описание (уровень, предметы, назначение аккаунта)"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Отмена" Click="CancelBtn_Click"
                        Background="#232738" Foreground="#CBD5E1" BorderThickness="0"
                        Padding="15,8" Margin="0,0,8,0" Cursor="Hand"/>
                <Button x:Name="SaveBtn" Content="Сохранить" Click="SaveBtn_Click"
                        Background="#3B82F6" Foreground="White" BorderThickness="0"
                        Padding="18,8" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
