<Window x:Class="RobloxAccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Account Manager — Мульти-аккаунт Лаунчер"
        Height="760" Width="1140" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#0F111A">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#25283B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#161926"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2A2E45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ВЕРХНЯЯ ШАПКА: Логотип, Статус Multi-Roblox и Кнопки добавления аккаунтов -->
        <Border Grid.Row="0" Background="#171A29" CornerRadius="10" Padding="18,14" Margin="0,0,0,14"
                BorderBrush="#252940" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3B82F6" Width="38" Height="38" CornerRadius="9" Margin="0,0,14,0">
                        <TextBlock Text="R" Foreground="White" FontSize="22" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Roblox Account Manager" Foreground="#F8FAFC" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Быстрый вход в 1 клик • Мульти-окна • Зашифрованное хранение сессий (DPAPI)"
                                   Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Переключатель Multi-Roblox + Добавление аккаунтов -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#11131F" CornerRadius="8" Padding="12,7" Margin="0,0,14,0"
                            BorderBrush="#252940" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="MultiMutexIndicator" Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0"/>
                            <CheckBox x:Name="MultiRobloxToggle" Content="Мульти-Roblox (Несколько окон)"
                                      IsChecked="True" Checked="MultiRobloxToggle_Changed" Unchecked="MultiRobloxToggle_Changed"
                                      Foreground="#E2E8F0" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ModernButton}" Background="#3B82F6"
                            Content="➕ Войти через браузер" Click="AddViaBrowser_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ModernButton}" Background="#262A40"
                            Content="🔑 Вставить Cookie" Click="AddViaCookie_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ПАНЕЛЬ ВЫБОРА ИГРЫ И ЗАПУСКА -->
        <Border Grid.Row="1" Background="#171A29" CornerRadius="10" Padding="18,14" Margin="0,0,0,14"
                BorderBrush="#252940" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поле Place ID или ссылки на игру -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Place ID или ссылка Roblox (включая приватный сервер):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="PlaceInputTextBox" Style="{StaticResource DarkTextBox}"
                             TextChanged="PlaceInputTextBox_TextChanged"
                             ToolTip="Вставьте Place ID, ссылку на игру или приватный сервер Roblox"/>
                </StackPanel>

                <!-- Поле VIP-сервера или JobId -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Ник игрока (зайти к нему) или JobId:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="VipOrJobTextBox" Style="{StaticResource DarkTextBox}"
                             TextChanged="PlaceInputTextBox_TextChanged"
                             ToolTip="Ник Roblox — вход на сервер игрока (Place ID не нужен). Также принимает JobId или ссылку приватного сервера."/>
                    <CheckBox x:Name="AutoReconnectCheckBox" Content="Переподключаться при дисконнекте"
                              Foreground="#CBD5E1" FontSize="12" Margin="0,6,0,0"
                              Checked="AutoReconnectCheckBox_Changed" Unchecked="AutoReconnectCheckBox_Changed"
                              ToolTip="Следит за логом клиента: при потере соединения (Error 277 и др.) закрывает окно и перезаходит этим аккаунтом в ту же цель"/>
                    <CheckBox x:Name="PreventSleepCheckBox" Content="Не уходить в сон (даже с закрытой крышкой)"
                              Foreground="#CBD5E1" FontSize="12" Margin="0,5,0,0"
                              Checked="PreventSleepCheckBox_Changed" Unchecked="PreventSleepCheckBox_Changed"
                              ToolTip="Включает запрет сна Windows при бездействии и при закрытии крышки ноутбука. При снятии галочки возвращает стандартное поведение."/>
                    <CheckBox x:Name="AntiAfkCheckBox" Content="Анти-АФК для всех окон (сброс 20-мин таймера)"
                              Foreground="#CBD5E1" FontSize="12" Margin="0,5,0,0"
                              Checked="AntiAfkCheckBox_Changed" Unchecked="AntiAfkCheckBox_Changed"
                              ToolTip="Периодически (по умолчанию раз в 12 мин, когда вы не двигаете мышь) на долю секунды фокусирует каждое окно Roblox и нажимает нейтральную клавишу Right Ctrl — персонаж не двигается и кнопки интерфейса не нажимаются, но таймер бездействия сбрасывается."/>
                </StackPanel>

                <!-- Избранные плейсы -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Быстрый выбор игры (Избранное):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SavedPlacesCombo" SelectionChanged="SavedPlacesCombo_SelectionChanged"
                                  Padding="8,6" FontSize="13"/>
                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="⭐"
                                ToolTip="Сохранить текущую игру или приватный сервер в избранное"
                                Click="SaveCurrentPlace_Click" Padding="10,6" Margin="6,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource ModernButton}" Content="🗑"
                                Background="#3F1D2B" Foreground="#FDA4AF"
                                ToolTip="Удалить выбранное избранное"
                                Click="DeleteSavedPlace_Click" Padding="10,6" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Массовый запуск выбранных аккаунтов -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource ModernButton}" Background="#262A40"
                            Content="⚙ Настройки Roblox" Click="RobloxSettings_Click"
                            HorizontalAlignment="Right" Padding="12,7" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Пауза (сек):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="DelaySecondsBox" Style="{StaticResource DarkTextBox}" TextChanged="DelaySecondsBox_TextChanged"
                                     Text="8" Width="54" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="LaunchSelectedBtn" Style="{StaticResource ModernButton}"
                                Background="#10B981" Padding="18,10"
                                Content="🚀 Запустить выбранные" Click="LaunchSelected_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SelectionSummaryText" Text="Выбрано: 0 аккаунтов"
                               Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. ПАНЕЛЬ ФИЛЬТРАЦИИ, ПОИСКА И ВЫБОРА ВСЕХ -->
        <Grid Grid.Row="2" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="SelectAllCheckBox" Content="Выбрать все в списке"
                      Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center" Margin="0,0,18,0"
                      ToolTip="Выбирает все аккаунты, которые сейчас отображаются по фильтру"
                      Click="SelectAllCheckBox_Click"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Группа:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="GroupFilterCombo" Width="150" SelectionChanged="GroupFilterCombo_SelectionChanged" Padding="8,5"/>
            </StackPanel>

            <TextBox Grid.Column="2" x:Name="SearchBox" Style="{StaticResource DarkTextBox}"
                     TextChanged="SearchBox_TextChanged"
                     Tag="Поиск по нику или заметке..."
                     ToolTip="Поиск по имени пользователя, DisplayName или заметке"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ModernButton}" Background="#1E293B" Foreground="#93C5FD" Padding="12,6" Margin="0,0,8,0"
                        Content="🗖 Расставить окна" Click="TileRobloxWindows_Click"
                        ToolTip="Равномерно расставить все открытые окна Roblox одинакового размера на весь экран (не закрывая панель задач)"/>
                <Button Style="{StaticResource ModernButton}" Background="#1E2235" Padding="12,6" Margin="0,0,8,0"
                        Content="🔄 Проверить сессии" Click="RefreshAccounts_Click"/>
                <Button Style="{StaticResource ModernButton}" Background="#3F1D2B" Foreground="#FDA4AF" Padding="12,6"
                        Content="⏹ Закрыть все окна Roblox" Click="CloseAllRoblox_Click"/>
            </StackPanel>
        </Grid>

        <!-- 4. СПИСОК АККАУНТОВ -->
        <Border Grid.Row="3" Background="#141724" CornerRadius="10" BorderBrush="#252940" BorderThickness="1" Padding="8">
            <Grid>
                <ListBox x:Name="AccountsListBox" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1B1F30" CornerRadius="9" Padding="14,10"
                                    BorderBrush="#2A2F47" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Чекбокс выбора -->
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Click="AccountSelection_Click"
                                              VerticalAlignment="Center" Margin="0,0,14,0"/>

                                    <!-- Аватарка -->
                                    <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23"
                                            Background="#252A40" Margin="0,0,14,0" ClipToBounds="True">
                                        <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Никнейм и ID -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC"
                                                   FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FormattedUsername}" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding UserId, StringFormat=ID: {0}}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Группа -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border Background="#252B42" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Group}" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Заметка -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Note}" Foreground="#CBD5E1" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                        <TextBlock Text="{Binding LastUsedFormatted, StringFormat=Запуск: {0}}"
                                                   Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Статус -->
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Кнопки действий в 1 клик -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ModernButton}" Background="#2563EB"
                                                Content="▶ Играть" Tag="{Binding}" Click="PlaySingleAccount_Click"
                                                Padding="14,7" Margin="0,0,6,0"
                                                ToolTip="Сразу зайти в игру с этого аккаунта"/>
                                        <Button Style="{StaticResource ModernButton}" Background="#262B40"
                                                Content="🌐 Браузер" Tag="{Binding}" Click="OpenAccountBrowser_Click"
                                                Padding="10,7" Margin="0,0,6,0"
                                                ToolTip="Открыть сайт Roblox под этим аккаунтом во встроенном браузере"/>
                                        <Button Style="{StaticResource ModernButton}" Background="#262B40"
                                                Content="✏" Tag="{Binding}" Click="EditAccount_Click"
                                                Padding="10,7" Margin="0,0,6,0"
                                                ToolTip="Изменить группу, заметку или куку"/>
                                        <Button Style="{StaticResource ModernButton}" Background="#3B1F2B" Foreground="#FDA4AF"
                                                Content="🗑" Tag="{Binding}" Click="DeleteAccount_Click"
                                                Padding="10,7"
                                                ToolTip="Удалить аккаунт из списка"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Пустое состояние, когда аккаунтов еще нет -->
                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="У вас пока не добавлено ни одного аккаунта Roblox"
                               Foreground="#E2E8F0" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Нажмите «➕ Войти через браузер» или «🔑 Вставить Cookie» сверху, чтобы добавить первый аккаунт."
                               Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button Style="{StaticResource ModernButton}" Background="#3B82F6"
                            Content="➕ Добавить первый аккаунт" Click="AddViaBrowser_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. НИЖНЯЯ СТРОКА СОСТОЯНИЯ -->
        <Grid Grid.Row="4" Margin="4,12,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FooterStatusText" Text="Готов к работе." Foreground="#94A3B8" FontSize="12" Margin="0,0,20,0"/>
                <TextBlock x:Name="RunningInstancesText" Text="Окон Roblox запущено: 0" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ModernButton}" Background="#1E2235" Padding="12,5" FontSize="12"
                        Content="📌 Создать ярлык на Рабочем столе" Click="CreateDesktopShortcut_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
