<Window x:Class="RobloxAccountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Account Manager"
        Height="740" Width="1120" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F17"
        ToolTipService.InitialShowDelay="220"
        ToolTipService.ShowDuration="15000">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#212538"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#131724"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#252A40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ВЕРХНЯЯ ШАПКА -->
        <Border Grid.Row="0" Background="#151826" CornerRadius="11" Padding="16,12" Margin="0,0,0,12"
                BorderBrush="#22273B" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3B82F6" Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="R" Foreground="White" FontSize="19" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Roblox Account Manager" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#1E2336" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="Текущая версия приложения. Все куки зашифрованы через Windows DPAPI.">
                            <TextBlock x:Name="AppVersionText" Text="v1.0" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Переключатель Multi-Roblox + Добавление аккаунтов -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10131E" CornerRadius="8" Padding="11,6" Margin="0,0,10,0"
                            BorderBrush="#22273B" BorderThickness="1"
                            ToolTip="Разрешает открывать сколько угодно окон Roblox одновременно (автоматически освобождает системный мьютекс ROBLOX_singletonEvent)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="MultiMutexIndicator" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0"/>
                            <CheckBox x:Name="MultiRobloxToggle" Content="Мульти-Roblox"
                                      IsChecked="True" Checked="MultiRobloxToggle_Changed" Unchecked="MultiRobloxToggle_Changed"
                                      Foreground="#E2E8F0" FontWeight="SemiBold" VerticalContentAlignment="Center" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ModernButton}" Background="#3B82F6"
                            Content="➕ Браузер" Click="AddViaBrowser_Click" Margin="0,0,8,0"
                            ToolTip="Войти в аккаунт через встроенный изолированный браузер (сессия сохранится автоматически)"/>
                    <Button Style="{StaticResource ModernButton}" Background="#23283D"
                            Content="🔑 Cookie" Click="AddViaCookie_Click"
                            ToolTip="Добавить аккаунт прямой вставкой токена .ROBLOSECURITY"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ПАНЕЛЬ ВЫБОРА ЦЕЛИ И ЗАПУСКА -->
        <Border Grid.Row="1" Background="#151826" CornerRadius="11" Padding="16,12" Margin="0,0,0,12"
                BorderBrush="#22273B" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="1.8*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поле игры / ссылки -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Игра или ссылка" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="PlaceInputTextBox" Style="{StaticResource DarkTextBox}"
                             TextChanged="PlaceInputTextBox_TextChanged"
                             ToolTip="Вставьте Place ID, ссылку на игру или приватный сервер (share?code=... или privateServerLinkCode=...). Оставьте пустым для входа на главную."/>
                </StackPanel>

                <!-- Поле Игрока или JobId -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Ник игрока или JobId" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="VipOrJobTextBox" Style="{StaticResource DarkTextBox}"
                             TextChanged="PlaceInputTextBox_TextChanged"
                             ToolTip="Укажите @ник игрока (чтобы зайти прямо к нему на сервер без Place ID), JobId конкретного сервера или ссылку приватного сервера."/>
                </StackPanel>

                <!-- Избранное -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Избранное" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SavedPlacesCombo" SelectionChanged="SavedPlacesCombo_SelectionChanged"
                                  Padding="8,6" FontSize="13"
                                  ToolTip="Быстрый выбор сохранённой игры или приватного сервера"/>
                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="⭐"
                                ToolTip="Сохранить текущую игру или приватный сервер в избранное"
                                Click="SaveCurrentPlace_Click" Padding="10,6" Margin="6,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource ModernButton}" Content="🗑"
                                Background="#361B28" Foreground="#FDA4AF"
                                ToolTip="Удалить выбранную запись из избранного"
                                Click="DeleteSavedPlace_Click" Padding="10,6" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Кнопка массового запуска и пауза -->
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Bottom"
                                ToolTip="Пауза в секундах между запуском очередного аккаунта при массовом старте">
                        <TextBlock Text="Пауза" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBox x:Name="DelaySecondsBox" Style="{StaticResource DarkTextBox}" TextChanged="DelaySecondsBox_TextChanged"
                                 Text="6" Width="48" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="LaunchSelectedBtn" Style="{StaticResource ModernButton}"
                            Background="#10B981" Padding="16,9" VerticalAlignment="Bottom"
                            Content="🚀 Запустить" Click="LaunchSelected_Click"
                            ToolTip="Поочерёдно запустить все отмеченные галочками аккаунты"/>
                </StackPanel>

                <!-- Нижний ряд: Компактные переключатели автоматизации + Настройки -->
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoReconnectCheckBox" Content="Авто-реконнект"
                                  Style="{StaticResource CompactCheckBox}" Margin="0,0,20,0"
                                  Checked="AutoReconnectCheckBox_Changed" Unchecked="AutoReconnectCheckBox_Changed"
                                  ToolTip="Следит за логом каждого окна: при потере связи или кике (Error 277, 279, 267 и др.) автоматически закрывает окно и перезаходит тем же аккаунтом. Не мешает внутриигровым телепортам."/>
                        <CheckBox x:Name="AntiAfkCheckBox" Content="Анти-АФК"
                                  Style="{StaticResource CompactCheckBox}" Margin="0,0,20,0"
                                  Checked="AntiAfkCheckBox_Changed" Unchecked="AntiAfkCheckBox_Changed"
                                  ToolTip="Каждые 12 минут (когда вы не трогаете мышь и клавиатуру) на долю секунды отправляет безопасное нажатие Right Ctrl во все окна Roblox, сбрасывая 20-минутный таймер бездействия."/>
                        <CheckBox x:Name="PreventSleepCheckBox" Content="Не спать (крышка)"
                                  Style="{StaticResource CompactCheckBox}"
                                  Checked="PreventSleepCheckBox_Changed" Unchecked="PreventSleepCheckBox_Changed"
                                  ToolTip="Запрещает Windows уходить в сон от бездействия и при закрытии крышки ноутбука. При отключении или выходе возвращает ваши прежние настройки питания."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectionSummaryText" Text="Выбрано: 0"
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource ModernButton}" Background="#23283D" Padding="11,5" FontSize="12"
                                Content="⚙ Настройки" Click="RobloxSettings_Click"
                                ToolTip="Настройки графики, лимита FPS, приоритета фоновых процессов и таймаутов"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. ПАНЕЛЬ ФИЛЬТРАЦИИ И ИНСТРУМЕНТОВ ОКОН -->
        <Grid Grid.Row="2" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="SelectAllCheckBox" Content="Выбрать все"
                      Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"
                      ToolTip="Отметить или снять выделение со всех отображаемых в списке аккаунтов"
                      Click="SelectAllCheckBox_Click"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Группа:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="12.5"/>
                <ComboBox x:Name="GroupFilterCombo" Width="135" SelectionChanged="GroupFilterCombo_SelectionChanged" Padding="8,5"
                          ToolTip="Фильтр аккаунтов по группе"/>
            </StackPanel>

            <TextBox Grid.Column="2" x:Name="SearchBox" Style="{StaticResource DarkTextBox}"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Быстрый поиск по нику, отображаемому имени, группе или заметке"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ModernButton}" Background="#1B253B" Foreground="#93C5FD" Padding="11,6" Margin="0,0,6,0"
                        Content="🗖 Сетка окон" Click="TileRobloxWindows_Click"
                        ToolTip="Равномерно расставить все открытые окна Roblox плиткой на весь экран (не закрывая панель задач)"/>
                <Button Style="{StaticResource ModernButton}" Background="#1D2233" Padding="11,6" Margin="0,0,6,0"
                        Content="🔄 Проверить" Click="RefreshAccounts_Click"
                        ToolTip="Проверить активность сессий и обновить аватарки всех аккаунтов"/>
                <Button Style="{StaticResource ModernButton}" Background="#361B28" Foreground="#FDA4AF" Padding="11,6"
                        Content="⏹ Закрыть все" Click="CloseAllRoblox_Click"
                        ToolTip="Принудительно закрыть все запущенные окна Roblox"/>
            </StackPanel>
        </Grid>

        <!-- 4. СПИСОК АККАУНТОВ -->
        <Border Grid.Row="3" Background="#121521" CornerRadius="11" BorderBrush="#22273B" BorderThickness="1" Padding="8">
            <Grid>
                <ListBox x:Name="AccountsListBox" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#191D2E" CornerRadius="9" Padding="12,9"
                                    BorderBrush="#262B42" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2.1*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.9*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Click="AccountSelection_Click"
                                              VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand"/>

                                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                                            Background="#23283E" Margin="0,0,12,0" ClipToBounds="True">
                                        <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC"
                                                   FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FormattedUsername}" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding UserId, StringFormat=ID: {0}}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border Background="#222840" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Group}" Foreground="#93C5FD" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Note}" Foreground="#CBD5E1" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                        <TextBlock Text="{Binding LastUsedFormatted}"
                                                   Foreground="#64748B" FontSize="11" Margin="0,2,0,0"
                                                   ToolTip="Время последнего запуска аккаунта"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ModernButton}" Background="#2563EB"
                                                Content="▶" Tag="{Binding}" Click="PlaySingleAccount_Click"
                                                Padding="12,6" Margin="0,0,5,0"
                                                ToolTip="Запустить игру с этого аккаунта"/>
                                        <Button Style="{StaticResource ModernButton}" Background="#24293E"
                                                Content="🌐" Tag="{Binding}" Click="OpenAccountBrowser_Click"
                                                Padding="10,6" Margin="0,0,5,0"
                                                ToolTip="Открыть сайт Roblox под этим аккаунтом во встроенном браузере"/>
                                        <Button Style="{StaticResource ModernButton}" Background="#24293E"
                                                Content="✏" Tag="{Binding}" Click="EditAccount_Click"
                                                Padding="10,6" Margin="0,0,5,0"
                                                ToolTip="Изменить группу, заметку или куку"/>
                                        <Button Style="{StaticResource ModernButton}" Background="#361B28" Foreground="#FDA4AF"
                                                Content="🗑" Tag="{Binding}" Click="DeleteAccount_Click"
                                                Padding="10,6"
                                                ToolTip="Удалить аккаунт из списка"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Пустое состояние -->
                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Список аккаунтов пуст"
                               Foreground="#E2E8F0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Добавьте первый аккаунт через встроенный браузер или токен .ROBLOSECURITY"
                               Foreground="#94A3B8" FontSize="12.5" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <Button Style="{StaticResource ModernButton}" Background="#3B82F6"
                            Content="➕ Добавить аккаунт" Click="AddViaBrowser_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. НИЖНЯЯ СТРОКА СОСТОЯНИЯ, ОБНОВЛЕНИЕ И ВЫГРУЗКА ЛОГА -->
        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FooterStatusText" Text="Готов к работе." Foreground="#94A3B8" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxWidth="540" Margin="0,0,16,0"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="RunningInstancesText" Text="Окон: 0" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"
                           ToolTip="Количество активных игровых окон Roblox и освобождённых singleton-хэндлов"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateAppBtn" Style="{StaticResource ModernButton}" Background="#1B253B" Foreground="#93C5FD"
                        Padding="11,5" FontSize="12" Margin="0,0,6,0"
                        Content="⬇ Обновить" Click="UpdateApp_Click"
                        ToolTip="Проверить наличие новой версии на GitHub и автоматически обновить приложение"/>
                <Button x:Name="ExportLogsBtn" Style="{StaticResource ModernButton}" Background="#1D2233" Foreground="#CBD5E1"
                        Padding="11,5" FontSize="12" Margin="0,0,6,0"
                        Content="📋 Лог ошибок" Click="ExportErrorLog_Click"
                        ToolTip="Сохранить компактный отчёт о работе и перехваченных ошибках (без куки и личных данных)"/>
                <Button Style="{StaticResource ModernButton}" Background="#1D2233" Foreground="#CBD5E1"
                        Padding="10,5" FontSize="12"
                        Content="📌 Ярлык" Click="CreateDesktopShortcut_Click"
                        ToolTip="Создать ярлык Roblox Account Manager на Рабочем столе"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
